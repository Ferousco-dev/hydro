# Hydro environment template.
#
# Android builds do NOT auto-load this file. `app/build.gradle.kts` reads the key from,
# in order:
#   1. `GEMINI_API_KEY` in `local.properties` (gitignored, recommended for local builds)
#   2. the `GEMINI_API_KEY` environment variable (recommended for CI)
#
# Either add the line below to local.properties, or export it in your shell:
#   export GEMINI_API_KEY="your-key-here"
#
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# News tool (Tavily). Optional: without it the news tool reports "unavailable".
# Create a key at https://app.tavily.com
#   export TAVILY_API_KEY="tvly-..."
TAVILY_API_KEY=

# Google Maps Platform (one key). Enable these APIs on the key's Cloud project:
# Routes, Geocoding, Places (New), Weather, Air Quality, Pollen (+ Maps SDK for Android for the map).
# Create a key at https://console.cloud.google.com/google/maps-apis and restrict it.
GOOGLE_MAPS_API_KEY=
